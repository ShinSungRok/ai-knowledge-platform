# P2 Service Completion Phase A/B — local host (copy to .env as needed)
# Do not commit real secrets. .env is gitignored; this file is not.

HOST=127.0.0.1
PORT=8080
API_KEY=demo-key
API_KEY_SUBJECT=demo-user
WORKSPACE_ID=workspace-a
# SKIP_DEMO_SEED=1

# Phase B optional Postgres SoT (omit DATABASE_URL to keep InMemory / no Docker)
# docker compose -f docker/docker-compose.yml up -d postgres
# DATABASE_URL=postgres://knowledge:knowledge@127.0.0.1:5432/knowledge

# Phase B optional OpenSearch VectorIndex (omit OPENSEARCH_URL to keep in-memory/sql vectors)
# docker compose -f docker/docker-compose.yml up -d opensearch
# OPENSEARCH_URL=http://127.0.0.1:9200
# OPENSEARCH_INDEX=knowledge-embeddings
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=

# Compose app (InMemory): docker compose -f docker/docker-compose.yml up app --build
# Compose full: docker compose -f docker/docker-compose.yml --profile full up app-full postgres opensearch --build

# P3 Later thin Workflow HTTP (default: P2 bridge when demo seed runs)
# WORKFLOW_P2_BRIDGE=0   # force Fake-only researcher
# WORKFLOW_P2_BRIDGE=1   # force P2 cited-answer researcher bridge

# Phase B optional HTTP LLM (omit LLM_API_KEY to keep Fake LLM / no network)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=30000
